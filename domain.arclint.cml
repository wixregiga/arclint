// The Ubiquitous Language of arclint, recorded by ArcLint.

Domain arclint {
  domainVisionStatement = "ArcLint records domain meanings, checks architectural Rules, distributes Patterns, and supplies guidance and domain review to coding agents."
}

ContextMap {
  contains agent, vocabulary, rule, adoption, conformance, distribution
  // @arclint description "rule reads the recorded language as vocabulary spells it: an Expansion resolves against the UbiquitousLanguage without redefining a term, so dependence flows rule -> vocabulary and never back."
  vocabulary [U]->[D,CF] rule

  // @arclint description "conformance judges code against the block invariants exactly as vocabulary records them, so dependence flows conformance -> vocabulary and never back."
  vocabulary [U]->[D,CF] conformance

  // @arclint description "conformance adopts the rule context's model as-is: assessments consume Rule, Severity, and the rest of the rule model directly, so dependence flows conformance -> rule and never back."
  rule [U]->[D,CF] conformance

  // @arclint description "adoption speaks the rule context's model unchanged: a Binding names a Zone, an Override names a Rule, and neither redefines them, so dependence flows adoption -> rule and never back."
  rule [U]->[D,CF] adoption

  // @arclint description "distribution moves Patterns around without redefining them: a Manifest names a PatternReference and a VendoredPattern carries a Pattern as the rule context spells it, so dependence flows distribution -> rule and never back."
  rule [U]->[D,CF] distribution

  // @arclint description "adoption consumes the distribution model unchanged: an Installation keeps a VendoredPattern and resolves through PatternSources, so dependence flows adoption -> distribution and never back."
  distribution [U]->[D,CF] adoption

  // @arclint description "conformance applies adoption's decisions as adoption records them: a Disablement stops a Rule's evaluation, an Exclusion removes subjects from what a Rule judges, and a Suppression keeps a finding reported without its gate effect, so dependence flows conformance -> adoption and never back."
  adoption [U]->[D,CF] conformance

  // @arclint description "agent names Zones exactly as the ruleset declares them: context shows the Zones that own a path, and a change is covered once every Zone that owns it has been shown, so dependence flows agent -> rule and never back."
  rule [U]->[D,CF] agent
}

BoundedContext agent {
  domainVisionStatement = "The language of agents using ArcLint and the order a coding agent follows when it works in a project. It obtains ArcLint context for the paths it will change, records a new or changed meaning in the domain recording before implementing it, implements, and runs the project's check before it finishes. Guidance names a step the observed work skipped and the next action to take. Guidance advises the agent and its user; it never blocks their work. The instructions ArcLint gives an agent (the domain-librarian skill, the AGENTS.md workflow block and the hooks' text) are the same whatever format the domain recording is written in: the agent learns which file it is from arclint context and arclint domain, and records through arclint domain define and arclint domain remove, so ArcLint writes the format. The AGENTS.md block also carries a snapshot of the Rules and the recorded domain, and the project's check reports the block when that snapshot is stale."
  "Compares an Activity with the session's Progress and returns the Guidance the Activity calls for, together with the Progress that includes it. A session receives each reminder once, so repeated actions do not repeat it."
  Service WorkflowGuide {
    void Advise();
    "WorkflowGuide advises running the project's check when a turn finishes with changes no check has verified and no earlier Guidance has named."
    void assertCheckBeforeFinish() hint = "arclint.on=Advise";
    "WorkflowGuide advises obtaining context, once for each path, when a file changes before context has shown every Zone that owns it."
    void assertContextBeforeChange() hint = "arclint.on=Advise";
    "WorkflowGuide advises recording new or changed meaning first, once in a session, when a file that bears domain meaning changes before the domain recording has changed."
    void assertDomainBeforeChange() hint = "arclint.on=Advise";
  }

  Module agent {
    "One observed action of the coding agent: obtaining context, changing the domain recording, changing a file, running the project's check, or finishing its turn. A changed file carries the Zones that own it and whether it bears domain meaning."
    ValueObject Activity {
      "An Activity of obtaining context shows the Zones that own each path it names together with the Zones it names, and every Zone when it names neither."
      def void ensureContextShowsOwningAndNamedZones();
      "An Activity bears domain meaning exactly when its changed file is not a test and lies in the model's code: a Zone named for a context, or anywhere while no context is recorded or one lacks its Zone."
      def void ensureDomainMeaningInTheModelsCode();
    }

    "Advice naming the workflow step an Activity skipped and the paths it concerns. Guidance carries no approval and no authority to block."
    ValueObject Guidance

    "What one session has done in the workflow and the Guidance it has already received: the Zones context has shown, whether the domain recording changed, and the files changed since the last check."
    ValueObject Progress
  }
}

BoundedContext vocabulary {
  domainVisionStatement = "The recorded Ubiquitous Language of a project and the meta-model that checks it: building blocks, their invariants and tiered sources, and the rules arclint declines to enforce with their reasons. The rule context reads it to expand a Rule; the conformance context reads it to judge code. A DomainRecording holds it in YAML or CML; the format changes nothing."
  Module vocabulary {
    "The file a project writes its Ubiquitous Language down in: the file's path from the directory that holds the ruleset, and the format the file is written in. The ruleset may name the file under domain.file; when it names none, the DomainRecording is the first of domain.arclint.yaml, domain.arclint.yml and domain.arclint.cml that exists, YAML first because YAML is the preferred format, and domain.arclint.yaml when none does. A default-named file that is not the DomainRecording is ignored. When discovery chose, the files it passed over are reported; a file the ruleset names is the project's own choice, and nothing is reported about the files beside it. A DomainRecording may hold more than the language, as a CML model does, and what it holds beyond the language is left as it is. Every command, hook, finding and report that names the project's domain file names its DomainRecording."
    ValueObject DomainRecording {
      "A DomainRecording is written in the format its file's extension names, YAML for .yaml or .yml and CML for .cml, so a file whose extension names neither is never a DomainRecording."
      def void ensureFormatNamedByExtension();
      "A DomainRecording's file, followed through any link, lies inside the repository, the directory that holds the ruleset."
      def void ensureInsideTheRepository();
    }

    "The most words one kind of recorded text may hold: 40 for an entry's definition or an invariant's or assertion's statement, 60 for a bounded context's definition, 100 for the project description. A definition says what a word means."
    ValueObject WordLimit
  }
}

BoundedContext rule {
  domainVisionStatement = "The rule bounded context: the Rule aggregate's home, holding everything a Rule is made of and everything it names. The ruleset is rules.arclint.yaml; it may name the project's domain file under domain.file."
  Aggregate Rule {
    "One enforceable architecture constraint configured in rules.arclint.yaml. A Rule keeps its RuleID while everything human-facing about it can be renamed. Aggregate evidence, from the rules.arclint.yaml header: \"Rule is the sole aggregate\". A Rule's identity, its Rationale, its Scope, and its Severity change together in one edit of rules.arclint.yaml."
    Entity Rule {
      aggregateRoot
      RuleID id key
      "A Rule's Constraint must accept its Scope."
      def void ensureConstraintAcceptsScope();
      "A Rule may carry an Expansion only as a structure Rule, and its parameters must be exactly the Expansion's resolution against the recorded language. When nothing is recorded the parameters are empty and the generated proposition says so."
      def void ensureExpansionOnlyAsStructure();
      "A Rule carries exactly one Constraint; a Rule written with two constraint keys, or with none and no Override target, is rejected at load."
      def void ensureExactlyOneConstraint();
      "Two Rules with the same qualified RuleID cannot both exist in one repository; a repository Rule spelled with the RuleID of a Rule an extended Pattern distributes is rejected at load."
      def void ensureUniqueQualifiedId();
      "A Zone in a repository ruleset has at least one path; a Zone written with no paths is legal only in a Pattern file, where a Binding supplies them later."
      def void ensureZoneHasAPath();
      "A Pattern lists its Zones without paths, and every Rule the Pattern distributes names only Zones the Pattern lists."
      def void ensurePatternListsZonesWithoutPaths();
    }

    "A named group of folders and files an architecture speaks about, such as domain or delivery. A Zone keeps its ZoneName while the paths that belong to it change: a Rule says \"on: domain\" and never repeats a folder. A Pattern lists its Zones with descriptions and no paths; a repository ruleset gives every Zone its paths, either directly or through a Binding. Recorded inside the Rule aggregate because rules.arclint.yaml makes Rule the sole aggregate and Zone lives in its home."
    Entity Zone {
      ZoneName id key
    }

    "A named, namespaced collection of Rules and Zones published for other repositories to extend, with a documentation link and the Languages it covers. A Pattern carries no repository policy: the runtime a repository targets, what it scans, what it extends and where it records its domain stay the adopting repository's own choices. A Pattern keeps its namespace and name across versions; a repository always extends one exact version through a PatternReference. Every Rule a Pattern distributes carries the Pattern's namespace in its RuleID. Recorded inside the Rule aggregate because rules.arclint.yaml makes Rule the sole aggregate and Pattern lives in its home."
    Entity Pattern {
      PatternReference id key
    }
  }

  Module rule {
    "The stable identity of a Rule, spelled explicitly in rules.arclint.yaml. A repository Rule's RuleID is local; a Rule a Pattern distributes is qualified by that Pattern's namespace/name, spelled namespace/name:local, so two Patterns may distribute the same local identity and both apply under distinct RuleIDs. Every record arclint keeps about a Rule over time keys on it, so it outlives renames of anything else about the Rule, and it never carries a version."
    ValueObject RuleID {
      "A distributed Rule's RuleID is qualified by the full namespace/name of its Pattern, never by the namespace alone, so Patterns that share a namespace may distribute the same local identity without colliding."
      def void ensureQualifiedByFullPatternName();
    }

    "The lowercase name a ruleset spells for a Zone, the only way a Rule, a Binding, or an Exclusion refers to one."
    ValueObject ZoneName

    "The author's explanation of why a Rule's Constraint is needed. It is optional: a Rule with no supplied explanation has no Rationale. An Expansion changes the resolved Constraint, never the author's Rationale. The explanation is never generated from the Constraint."
    ValueObject Rationale

    "The one checkable proposition a Rule carries, written in rules.arclint.yaml as exactly one constraint key with its parameters: imports, structure, naming, invariants, layers, imported_by, independent, acyclic, content, or uses. The key alone decides how the Rule is evaluated; a Rule never carries two."
    ValueObject Constraint

    "Which code a Rule applies to: the repository or selected Zones, optionally narrowed by file paths, with Exclusions removing selected code from evaluation. A Scope is carried by its Rule and has no independent identity."
    ValueObject Scope

    "Gate importance of a finding: error, warning, or info. Described entirely by its value and validated at construction. Two equal spellings are interchangeable."
    ValueObject Severity {
      "A Severity must be one of error, warning, or info; any other spelling is rejected at construction, never stored."
      def void ensureClosedSet();
    }

    "A source language arclint recognizes and can analyze: go, typescript, or python. A repository ruleset states which Languages it runs under runtime, and a Pattern states which Languages it covers. Recognition does not promise that every Rule covers the Language."
    ValueObject Language

    "The exact spelling namespace/name@version by which a repository extends one published version of a Pattern. A Rule a Pattern distributes carries the PatternReference as its provenance, and two references with the same spelling resolve to the same Pattern version."
    ValueObject PatternReference

    "How a structure Rule's globs derive from one recorded vocabulary collection: an ExpansionSource plus authored globs whose {name:<case>} placeholders resolve once per recorded term. It is pure substitution, with no predicates, filters, or joins. Logic beyond substitution belongs in an extension. The Rule stays the sole aggregate: an expanded Rule is one Rule stating one universally quantified proposition."
    ValueObject Expansion {
      "An Expansion must name a published ExpansionSource, declare at least one require or forbid glob, and use braces only as {name:<case>} placeholders with a published TermCase. Anything else is rejected at construction, never loaded."
      def void ensureWellFormed();
    }

    "The recorded collection an Expansion derives from, one of the closed set domain.aggregates, domain.entities, domain.value_objects, domain.events, domain.contexts, domain.invariants, domain.assertions, domain.specifications. A new source is a deliberate design act, never a syntax feature."
    ValueObject ExpansionSource

    "One published rendering of a recorded term as a path or identifier segment: flatcase, snake_case, kebab-case, camelCase, or PascalCase. One producing implementation serves both surfaces, the rules.arclint.yaml {name:<case>} placeholders and the extension SDK's ctx.caseTerm, so whatever the ruleset grammar expresses an extension can see. A CaseSpec checks names; a TermCase produces them."
    ValueObject TermCase {
      "A TermCase never renders an empty segment: a term without letters or digits is rejected at resolution."
      def void ensureNeverEmptySegment();
    }

    "The finite case vocabulary a naming Rule matches file stems against in rules.arclint.yaml: kebab-case, snake_case, camelCase, PascalCase, or a regex, combined as alternatives."
    ValueObject CaseSpec

    "The project's domain file as the ruleset knows it: the DomainRecording rules.arclint.yaml names under domain.file, that init writes there, or that a translation moves the language into. A path a person writes becomes the project's DomainRecording only as a DomainFile, because only the ruleset says which file holds the project's language. A default-named file that discovery finds is held to the same rule, so no command ever reads or writes the ruleset as a language."
    ValueObject DomainFile {
      "A project's domain file is never rules.arclint.yaml, not even through a link."
      def void ensureNeverTheRuleset();
    }

    "How strongly a Rule's enforcement decides its Constraint: exact, partial, heuristic, or advisory. Assurance is independent from Severity. It speaks for the Constraint as written, never for the Rationale. A content Rule is exact for its pattern: a line the pattern matches is found, and nothing checks that the pattern covers what the Rationale explains. So wherever a content Rule's Assurance is shown, it reads exact for its pattern, with its rationale not checked."
    ValueObject Assurance

    "One fixture scenario for one Rule, kept under .arclint/tests: fixture files and the complete result the Rule must produce on them. A RuleTest whose expected result holds at least one violation is a failing case; it shows a bad example the Rule catches. Since a content Rule's check decides only its pattern, every enabled content Rule needs at least one failing case drawn from its Rationale, and arclint rules test names each one that has none."
    ValueObject RuleTest

    "How long one Extension Rule's check may run before it stops and the Rule is reported as not evaluated. The Rule or an Override sets it; otherwise the 5-second default applies, as it always does to registration."
    ValueObject TimeLimit {
      "A TimeLimit is a positive duration; zero or a negative duration is rejected at load."
      def void ensurePositive();
    }
  }
  // @arclint question "pattern-holds-rules" "In code a Pattern carries the Rules it distributes, which reads like a boundary of its own, while rules.arclint.yaml keeps Rule the sole aggregate and forbids a pattern home. Is Pattern a member of the Rule aggregate, as recorded here, or an aggregate whose members are Rules?"
}

BoundedContext adoption {
  domainVisionStatement = "How one repository takes on Rules a Pattern distributes: binding the Pattern's Zones to paths and deciding, per Rule, what to disable, exclude, or suppress."
  Module adoption {
    "The paths an adopting repository gives to one Zone of a Pattern it extends, spelled under bind as one glob or a list of globs. A Binding is the only place a Pattern Zone's paths live; the Pattern's Rules never change when the folders do."
    ValueObject Binding {
      "A Binding names a Zone the extended Pattern lists and gives it at least one path; a Binding for a Zone the Pattern does not list is rejected at load."
      def void ensureNamesAListedZone();
      "Every Zone an extended Pattern lists has a Binding before the Pattern's Rules evaluate; a Zone left unbound is rejected at load."
      def void ensureEveryZoneBound();
    }

    "One adopting repository's decision on a distributed or built-in Rule, keyed by its RuleID. It is not a second Rule: it only disables the Rule, changes its Severity or TimeLimit, excludes subjects, or suppresses findings."
    ValueObject Override {
      "An Override names a distributed or built-in Rule; an Override whose RuleID matches neither is rejected at load."
      def void ensureNamesADistributedRule();
      "An Override carries no Constraint and no Rationale; adding either is rejected at load with the advice to add a new local Rule under a new RuleID."
      def void ensureCarriesNoAssertion();
    }

    "The decision to stop evaluating one Rule for the repository, with a reason. The Rule and its provenance stay inspectable and the reason is reported wherever the Rule is listed."
    ValueObject Disablement {
      "A Disablement carries a reason; disabling without one is rejected at load."
      def void ensureCarriesAReason();
    }

    "The decision removing selected paths or Zones from what one Rule judges, with a reason. Excluded subjects are reported as not applicable, never silently dropped."
    ValueObject Exclusion {
      "An Exclusion names at least one path or Zone and carries a reason; an Exclusion without either is rejected at load."
      def void ensureNamesASubjectWithAReason();
    }

    "The decision keeping a finding one Rule produced at selected paths while removing its gate effect, with a reason. The finding is still reported as suppressed."
    ValueObject Suppression {
      "A Suppression names at least one path and carries a reason; a Suppression without either is rejected at load."
      def void ensureNamesAPathWithAReason();
    }

    "The decision to extend one Pattern, recorded in rules.arclint.yaml as one extends entry that names the PatternReference and carries a Binding for every Zone the Pattern lists, drafted from the paths the Pattern suggests. Installing a Pattern the binary does not embed keeps a VendoredPattern first, so the repository resolves the PatternReference offline."
    ValueObject Installation {
      "An Installation of a Pattern whose namespace and name the repository already extends replaces the extended version and keeps every Binding; it never records a second extends entry for one namespace and name."
      def void ensureOneExtendsPerPattern();
    }
  }
}

BoundedContext conformance {
  domainVisionStatement = "Judging code against Rules: every assessment derives its Violations fresh from the observed repository."
  Module conformance {
    "The checks performed for one recorded invariant or assertion, together with checks not performed and their reasons, and the file and line of the declaration that carries the contract when a check located it."
    ValueObject ContractCoverage {
      "ContractCoverage reports a recorded contract as unchecked when none of its applicable Rules was evaluated."
      def void ensureUncheckedWithoutEvaluation();
      "ContractCoverage retains the outcome and limitations of every check."
      def void ensureRetainsCheckLimitations();
      "ContractCoverage never presents structural matching as proof of the recorded invariant or assertion."
      def void ensureStructuralChecksAreNotProof();
    }

    "One parsed import with its source file, source location, classification, resolved target, and source and target Zone memberships, including whether the target was observed. Incoming and outgoing are views of the same supplied value; equal attributes are interchangeable."
    ValueObject DependencyImport {
      "DependencyImport never presents a resolved package directory as an exact target file."
      def void ensurePreservesTargetPrecision();
      "DependencyImport retains a Go blank import as dependency evidence rather than treating it as an empty or failed result."
      def void ensureBlankImportIsADependency();
      "DependencyImport distinguishes an unobserved target from an observed target that belongs to no declared Zone."
      def void ensureUnobservedIsNotUnzoned();
    }

    "The collected information supplied to a consumer, with one meaning regardless of how a Rule is evaluated. For a Rule, the available information is determined by its required fact classes, Scope, Exclusions, and the evidence its Constraint needs. Selected subjects and evidence locations are distinct: an incoming dependency may originate outside the selected code without granting access to that file. Facts have no independent identity; equal supplied information and access are interchangeable. Repository inspection requests its own fact classes without inventing a Rule; its information uses the same observation and dependency meanings."
    ValueObject Facts {
      "Facts contains only evidence present in the supplied observations, never inferred runtime relationships."
      def void ensureObservedEvidenceOnly();
      "Facts preserves the same import attributes and Zone memberships for native evaluation, extension evaluation, and repository inspection."
      def void ensureOneMeaningForEveryConsumer();
      "Facts distinguishes an observed empty result from unavailable observations and from a parse failure."
      def void ensureEmptyIsNotUnavailable();
      "Facts supplied to a Rule contains no fact class that its enforcement does not require."
      def void ensureOnlyRequiredFacts();
      "Facts supplied to a Rule exposes content and declarations only for files selected by its Scope after file Exclusions."
      def void ensureScopeBoundsFileAccess();
      "Facts supplies dependency evidence according to the Rule's Constraint, retaining incoming and outgoing evidence when the Constraint needs it. Excluding a file from evaluation does not erase the existence of its Folder as dependency evidence. An unsupported evidence query is not an observed empty result."
      def void ensureEvidenceFollowsTheConstraint();
      "Facts never grants file access merely because a DependencyImport references that file."
      def void ensureImportsGrantNoAccess();
      "Facts permits an extension finding outside its selected subject only at the source location of supplied dependency evidence involving that subject."
      def void ensureFindingsUseSuppliedEvidence();
      "Facts never presents a call target or a field type as resolved unless the language's own resolution reached it; what resolution cannot follow is undetermined, with the reason."
      def void ensureUnresolvedIsUndetermined();
    }

    "One suspected breach of a Rule, anchored at a file and line and carrying the PatternReference of the Pattern that distributed the Rule when one did. It has no lifecycle: every assessment derives its Violations fresh, and two Violations with the same values are the same finding."
    ValueObject Violation

    "Why an Extension Rule was not evaluated: its Extension ran past its TimeLimit, or its code failed. It names its source, phase, the TimeLimit in force, how long it ran, the file last read when known, and any error raised."
    ValueObject ExtensionFailure {
      "ExtensionFailure always states its cause: the time limit its Extension exceeded, or the error its Extension raised while running."
      def void ensureStatesItsCause();
      "ExtensionFailure always names the phase its Extension stopped in: registration or check."
      def void ensureNamesItsPhase();
      "ExtensionFailure always states how long its Extension ran before it stopped, beside the time limit in force."
      def void ensureMeasuresItsRun();
    }

    "An Extension Rule's check that finished after more than half its TimeLimit; a run twice as slow would stop it. It is reported as coverage with its remedy: raise the TimeLimit where it is set, or reduce the work."
    ValueObject NearLimit {
      "A NearLimit is a check that ran longer than half its TimeLimit; a check that used half its TimeLimit or less is never near it."
      def void ensurePastHalfItsLimit();
      "A NearLimit always names the Extension that ran the check and the Extension's source file, beside the TimeLimit in force and how long the check ran."
      def void ensureNamesItsExtension();
    }

    "One place where a file's code reaches a recorded term the file does not declare: the file and line, the term with its bounded context, and how the code reaches it, by a call to the term's declaration or to a member of it, or by a field whose type holds it. arclint context lists the TermUses of a worksite as used here, apart from what is declared here, so whoever edits a file sees the contracts that bind the code it calls. A reference the language's resolution could not follow is reported as undetermined with the reason, so a missing use is never read as no use. Two TermUses with the same values are the same use."
    ValueObject TermUse {
      "A TermUse exists only where the language's own resolution reached the one declaration located for its term, a member of it, or a constructor of it; a matching name alone never makes one."
      def void ensureReachedThroughResolution();
    }
  }
}

BoundedContext distribution {
  domainVisionStatement = "Moving published Patterns between repositories without changing them: what a Registry publishes, what a repository vendors, and how a version proves it is the one that was published."
  Module distribution {
    "Every Pattern the resolving PatternSources carry, one entry per PatternReference in source order, with the agreeing copies of one reference kept beside the first. A listing reads the Catalog to say where a Pattern resolves from and what the repository carries of it; a check resolves the PatternReferences it extends through the Catalog."
    ValueObject Catalog

    "The sha256 content hash, spelled sha256:<hex>, that identifies the exact bytes of one PatternFile, or of a whole Pattern through the sorted list of its PatternFile paths and their Digests. Two copies of one published version share one Digest."
    ValueObject Digest {
      "A Digest computed twice over the same PatternFiles is the same Digest; file order, platform, and time never enter it."
      def void ensureDeterministic();
    }

    "A Registry's complete listing of the Pattern versions it publishes, one entry per PatternReference carrying the version's Digest and documentation, ordered by namespace, name, then version. The Index is read before any Manifest or PatternFile, so a Registry is listed and a Selection resolved without fetching a Pattern."
    ValueObject Index {
      "An Index lists one PatternReference at most once; a listing that repeats a reference is rejected at construction, because a published version is immutable."
      def void ensureOneEntryPerReference();
      "A Pattern fetched from a Registry must carry the Digest its Index records; a fetched version whose Digest disagrees with the Index is rejected, never vendored."
      def void ensureFetchedDigestAgrees();
    }

    "The record a published Pattern version travels with: its PatternReference, its Digest, and the path and Digest of every PatternFile it ships. A Manifest is written beside a VendoredPattern and read from a Registry before any PatternFile is fetched."
    ValueObject Manifest {
      "A Manifest lists every PatternFile of the Pattern and none outside the Pattern's directory; a path that is absolute, escapes the directory, or appears twice is rejected at construction."
      def void ensureListsEveryFileInsideThePattern();
    }

    "One file a Pattern ships: a forward-slash path relative to the Pattern's own directory and the file's bytes. The pattern.yaml file is always one of them, and every Extension the Pattern distributes lives under extensions/."
    ValueObject PatternFile

    "One place arclint resolves a PatternReference from: the Patterns embedded in the binary, the Patterns kept under .arclint/patterns in the repository, or a Registry. A check resolves through the first two only; a Registry is read when a command asks to vendor or install a Pattern."
    ValueObject PatternSource {
      "Two PatternSources that carry one PatternReference must agree on its Digest; a disagreement is rejected at load, because a published version is immutable."
      def void ensureSourcesAgreeOnADigest();
    }

    "A location, reachable by URL, that publishes Patterns by PatternReference: an index of every published reference and, per version, a Manifest beside the Pattern's files. The default Registry is arclint's own; a command may name another."
    ValueObject Registry {
      "A Registry is never read while a check runs; a check resolves only embedded and vendored Patterns."
      def void ensureNeverReadDuringACheck();
    }

    "The spelling a command accepts to name one Pattern among the PatternReferences a source carries: an exact namespace/name@version, a namespace/name meaning its highest version, or a bare name meaning the highest version of the one namespace/name that carries it."
    ValueObject Selection {
      "A bare-name Selection carried by more than one namespace/name is rejected as ambiguous, with every matching reference spelled out; nothing is chosen on the caller's behalf."
      def void ensureBareNameNeverAmbiguous();
    }

    "An exact copy of one published Pattern version kept under .arclint/patterns/<namespace>/<name>/ together with its Manifest, so the repository resolves the PatternReference offline. One name in one namespace has one vendored version."
    ValueObject VendoredPattern {
      "A VendoredPattern whose PatternFiles no longer match its Manifest is rejected at load, never used silently."
      def void ensureMatchesItsManifest();
    }
  }
}
