// hk pre-commit configuration for arclint.
// Pinned to the hk version installed via mise; run `hk install --mise` to
// write git hooks that execute through `mise x`, so contributors get the
// pinned toolchain without activating mise in their shell.
amends "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"

// Make owns every command. The hook splits formatting and linting from
// behavioral verification so fix mode can repair Go files before the
// full test and ArcLint suite runs.
local linters = new Mapping<String, Step> {
    ["golangci-fmt"] {
        glob = List("**/*.go")
        check = "make fmt-check"
        fix = "make fmt"
    }
    ["golangci-lint"] {
        glob = List("**/*.go")
        check = "make lint"
        fix = "make lint-fix"
        exclusive = true
    }
    ["gitleaks"] {
        check = "gitleaks detect --verbose"
        exclusive = true
    }
    ["verify"] {
        check = "make verify"
        exclusive = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps {
            ["golangci-fmt"] = linters["golangci-fmt"]
            ["golangci-lint"] = linters["golangci-lint"]
        }
    }
}
