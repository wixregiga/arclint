// hk pre-commit configuration for arclint.
// Pinned to the hk version installed via mise; run `hk install --mise` to
// write git hooks that execute through `mise x`, so contributors get the
// pinned toolchain without activating mise in their shell.
amends "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"

// The hook orchestrates linting and fast-paths like gitleaks protect.
// Fix mode automatically formats and repairs Go files.
local linters = new Mapping<String, Step> {
    ["golangci-lint"] {
        glob = List("**/*.go", ".golangci.yml", "go.mod", "mise.toml")
        check = "make _lint-no-fix"
        exclusive = true
    }
    ["spectral"] {
        glob = List("**/*.schema.json", ".spectral.yaml", "scripts/validation/schema/**")
        check = "make lint-schema"
        exclusive = true
    }
    ["gitleaks"] {
        check = "gitleaks protect --staged --verbose"
        exclusive = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps {
            ["golangci-lint"] = linters["golangci-lint"]
        }
    }
}
