// hk pre-commit configuration for arclint.
// Pinned to the hk version installed via mise; run `hk install --mise` to
// write git hooks that execute through `mise x`, so contributors get the
// pinned toolchain without activating mise in their shell.
amends "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"

// Steps route through make where a target exists, and the last step
// dogfoods arclint itself: make selfcheck lints this repository with
// its own rules.yaml, so an architecture break cannot be committed.
local linters = new Mapping<String, Step> {
    ["gofmt"] {
        glob = List("*.go")
        check = "test -z \"$(gofmt -l {{files}})\""
        fix = "gofmt -w {{files}}"
    }
    ["vet"] {
        glob = List("*.go")
        check = "make vet"
        exclusive = true
    }
    ["arclint-selfcheck"] {
        check = "make selfcheck"
        exclusive = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        steps = linters
    }
}
